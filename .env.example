# PromptBridge Environment Configuration

# Optional: Add your Google Gemini API Key for dynamic LLM generation
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Preferred model (default: gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: Port number for the server (default: 3000)
PORT=3000
